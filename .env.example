# ---------------------------------------------------------------------------
# Contact form delivery
#
# Every enquiry is saved as a lead (see /admin/leads) and emailed through
# Resend (https://resend.com) to every inbox in CONTACT_TO, with reply-to set
# to the visitor so hitting Reply answers them directly.
#
#   RESEND_API_KEY  Resend API key with sending access.
#   CONTACT_TO      Comma-separated inboxes, e.g. "you@example.com,team@example.com".
#                   Keep real addresses in Vercel / .env.local, not in this repo.
#   CONTACT_FROM    Sender. Its domain must be verified in Resend.
#                   Defaults to "PKDM Studio Website <website@pkdmstudio.com>".
#
# Fallback: if the server can't email (no key, or Resend fails), the browser
# also submits to Web3Forms with any NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY(_2) set.
# On Web3Forms' free tier each key delivers to the one inbox it was made for.
# ---------------------------------------------------------------------------

RESEND_API_KEY=re_your_resend_api_key
CONTACT_TO=you@example.com,team@example.com
# CONTACT_FROM=PKDM Studio Website <website@pkdmstudio.com>
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY_2=

# ---------------------------------------------------------------------------
# Admin dashboard (/admin) + first-party analytics
#
# 1. ADMIN_PASSWORD — the single password used to log in at /admin/login.
#    Pick something long and random. Sessions are signed with a key derived
#    from it (set ADMIN_SESSION_SECRET too if you ever want to rotate
#    sessions without changing the password).
#
# 2. DATABASE_URL — Neon Postgres connection string. Easiest path:
#    Vercel dashboard → Storage → Create Database → Neon (Postgres) →
#    connect it to this project. Vercel injects DATABASE_URL automatically
#    in production; locally run `vercel env pull .env.local`.
#
# 3. After the database is connected, run once:  npm run db:setup
#
# Without these set, the public site still builds and works fine — analytics
# events are simply dropped and /admin shows setup instructions.
# ---------------------------------------------------------------------------

ADMIN_PASSWORD=choose-a-long-random-password
# ADMIN_SESSION_SECRET=optional-extra-secret
# DATABASE_URL=postgres://user:pass@host/db  (injected by the Neon integration on Vercel)
